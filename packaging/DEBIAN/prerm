#!/bin/sh
# Lan-Share prerm: stop the relay only on full removal (upgrades keep it running).
set -e

case "$1" in
    remove|purge)
        if command -v systemctl >/dev/null 2>&1; then
            if systemctl is-enabled --quiet lan-share-relay.service 2>/dev/null; then
                systemctl stop lan-share-relay.service >/dev/null 2>&1 || true
                systemctl disable lan-share-relay.service >/dev/null 2>&1 || true
            fi
        fi
        ;;
    upgrade|failed-upgrade|deconfigure)
        ;;
esac

exit 0